#!/usr/bin/env bash
# ask-pi — Claude Code → Pi. Sends a message to Pi's bridge session for the
# CURRENT repo and prints Pi's reply on stdout, so the reply lands directly in
# the caller's context. No copy-paste, no daemon.
#
#   ask-pi "fix the 429 handling in fetch.py:88, rerun the tests"
#   git diff | ask-pi "review this diff"
#   ask-pi --thread qc "start on the QC backfill"     # parallel thread
#   ask-pi --new "clean slate: ..."                   # forget the thread
#
# Session is keyed to the git repo root, so each repo keeps its own memory and
# nothing bleeds between projects. Runs from the repo root regardless of cwd.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: ask-pi [options] <message>...     (message may also come from stdin)

options:
  -t, --thread NAME   named side-thread within this repo (default: main)
      --new           start a fresh thread, discarding prior bridge history
  -m, --model PATTERN override Pi's model (default: pi's own default)
      --raw           print Pi's reply only, no header
      --exclude-tools LIST
                      pass a comma-separated tool denylist to pi (pi's own
                      --exclude-tools). dispatch.sh sets it for workers;
                      unset means pi's normal tool set, exactly as before.
  -h, --help          this

env:
  PI_BRIDGE_MODEL     default model override
EOF
}

thread=""; thread_explicit=0; fresh=0; model="${PI_BRIDGE_MODEL:-}"; raw=0; exclude=""; args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -t|--thread) thread="$2"; thread_explicit=1; shift 2 ;;
    --new)       fresh=1; shift ;;
    -m|--model)  model="$2"; shift 2 ;;
    --raw)       raw=1; shift ;;
    --exclude-tools)
      [ $# -ge 2 ] || { echo "ask-pi: --exclude-tools needs a value" >&2; exit 2; }
      exclude="$2"; shift 2 ;;
    -h|--help)   usage; exit 0 ;;
    --)          shift; args+=("$@"); break ;;
    *)           args+=("$1"); shift ;;
  esac
done

msg="${args[*]-}"
# Only read stdin when it is genuinely piped or redirected from a file.
# Testing `! -t 0` is not enough: a non-tty stdin that never closes (agent
# harnesses, launchd) makes `cat` block forever.
if [ -p /dev/stdin ] || { [ ! -t 0 ] && [ -f /dev/stdin ]; }; then
  stdin_msg="$(cat)"
  [ -n "$stdin_msg" ] && msg="${msg}${msg:+$'\n\n'}${stdin_msg}"
fi
[ -n "${msg// }" ] || { usage >&2; exit 2; }

# Loop guard: Claude → Pi → Claude → Pi ... stops here.
depth="${AGENT_BRIDGE_DEPTH:-0}"
if [ "$depth" -ge 2 ]; then
  echo "ask-pi: bridge depth $depth — refusing to nest further (loop guard)." >&2
  exit 3
fi

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Lane context. The thread name doubles as the lane name, so a handoff carries
# its file-ownership rules instead of relying on someone pasting them.
# KEEP IN SYNC with the identical block in ask-claude.
lane_context() {
  local me="$1" reg mine="" others="" found=0
  local l_name l_agent l_session l_dir l_branch l_owns l_created l_claimed
  reg="$(git rev-parse --git-common-dir 2>/dev/null)/lanes.tsv"
  [ -f "$reg" ] || return 0
  while IFS=$'\t' read -r l_name l_agent l_session l_dir l_branch l_owns l_created l_claimed; do
    [ -n "$l_name" ] && [ "$l_name" != "name" ] || continue
    if [ "$l_name" = "$me" ]; then
      found=1; mine="$l_owns"
    else
      others="${others}${others:+; }${l_name} owns ${l_owns:-<whole repo>}"
    fi
  done < <(tail -n +2 "$reg")

  if [ "$found" -eq 1 ]; then
    printf '\n\nLANE: this thread is lane "%s" on branch %s.' "$me" "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
    if [ -n "$mine" ]; then
      printf ' It owns ONLY: %s. Nothing outside that may be edited or committed, and never run `git add -A` — it would sweep up another lane'"'"'s unfinished work. Work that needs paths outside the lane is out of scope: say so instead of doing it.' "$mine"
    else
      printf ' No owned paths were declared for it, so confirm scope before editing.'
    fi
  fi
  [ -n "$others" ] && printf '\nOther lanes are active in this repo — do NOT touch their paths: %s.' "$others"
  [ "$found" -eq 0 ] && [ -n "$others" ] && printf '\nYou have not claimed a lane. Run `lane new <name> --owns <path>` before editing.'
  return 0
}

# Default thread = the lane THIS agent session claimed. Two sessions in one
# worktree would otherwise both fall back to "main" and interleave their
# conversations in a single Pi thread. KEEP IN SYNC with ask-claude.
lane_for_session() {
  local reg me="${CLAUDE_CODE_SESSION_ID:-${PI_SESSION_ID:-}}"
  local l_name l_agent l_session l_dir l_branch l_owns l_created l_claimed
  [ -n "$me" ] || return 0
  reg="$(git -C "$root" rev-parse --git-common-dir 2>/dev/null)/lanes.tsv"
  [ -f "$reg" ] || return 0
  while IFS=$'\t' read -r l_name l_agent l_session l_dir l_branch l_owns l_created l_claimed; do
    [ -n "$l_name" ] && [ "$l_name" != "name" ] || continue
    [ "$l_claimed" = "$me" ] && { printf '%s' "$l_name"; return 0; }
  done < <(tail -n +2 "$reg")
  return 0
}

if [ "$thread_explicit" -eq 0 ]; then
  thread="$(cd "$root" && lane_for_session)"
  thread="${thread:-main}"
fi

slug="$(basename "$root" | tr -c '[:alnum:]' '-' | sed 's/-*$//')"
session="bridge-${slug}-${thread}"
[ "$fresh" -eq 1 ] && session="${session}-$(date +%Y%m%d-%H%M%S)"

preamble="You are Pi, working in ${root}. This message came from Claude Code over
the ask-pi bridge, not from a human — your reply is piped straight back into
Claude's context, so write for an agent: terse, concrete, no pleasantries.
Cite file:line for anything you changed and paste the actual command output that
proves it. If you are blocked or the request is ambiguous, say exactly what you
need in one line rather than guessing — Claude will call you again with it.
Never print secrets. You may reply to Claude yourself with: ask-claude \"...\""

cd "$root"
preamble="${preamble}$(lane_context "$thread")"
set -- -p --session-id "$session" --approve --append-system-prompt "$preamble"
[ -n "$model" ] && set -- "$@" --model "$model"
# One argv word: pi splits the comma list itself.
[ -n "$exclude" ] && set -- "$@" --exclude-tools "$exclude"

[ "$raw" -eq 1 ] || echo "── ask-pi → ${session} (${root}) ──" >&2

# One caller per thread at a time. Two processes appending to one session
# transcript interleave it; this turns that into a loud error. Not `exec`,
# so the trap can release the lock. KEEP IN SYNC with ask-claude.
#
# mkdir success is the ONLY thing that means "I hold the lock": the pid is
# published with a temp file + atomic `mv`, so a racer never sees a freshly-made
# lock whose pid file is torn or absent. On a lost mkdir, only a pid file naming
# a demonstrably dead process is reclaimed; an absent/unreadable pid means
# someone is mid-acquisition, so back off and retry a bounded number of times
# instead of rm -rf'ing under them. Same shape as lane's review_claim_lock
# (task 156); ported here by task 212.
lock="${TMPDIR:-/tmp}/agent-bridge-${session}.lock"
i=0
while :; do
  if mkdir "$lock" 2>/dev/null; then
    # test hook (task 212): hold the mkdir→pid-write window open so the
    # deterministic race test can prove a racer backs off and never reclaims.
    # Gated behind AGENT_BRIDGE_TEST_MODE=1 so a stray env var in a real shell
    # cannot silently widen the lock window.
    if [ "${AGENT_BRIDGE_TEST_MODE:-}" = 1 ] && [ -n "${AGENT_BRIDGE_LOCK_DELAY:-}" ]; then
      sleep "${AGENT_BRIDGE_LOCK_DELAY}"
    fi
    tmpfile="${lock}/pid.$$"
    echo $$ > "$tmpfile"
    mv "$tmpfile" "$lock/pid" 2>/dev/null || { rm -rf "$lock"; echo "ask-pi: cannot lock ${session}" >&2; exit 4; }
    break
  fi
  holder="$(cat "$lock/pid" 2>/dev/null || true)"
  if [ -n "$holder" ]; then
    if kill -0 "$holder" 2>/dev/null; then
      echo "ask-pi: thread '${thread}' is already in use by pid ${holder}." >&2
      echo "        Use -t <name> for a separate thread, or claim a lane so this session gets its own." >&2
      exit 4
    fi
    rm -rf "$lock"                     # stale: the pid named a dead process
    continue
  fi
  # pid absent/unreadable: the holder is still mid-acquisition — back off.
  i=$((i + 1))
  [ "$i" -le 250 ] || { echo "ask-pi: cannot lock ${session} (still being acquired after $i retries)" >&2; exit 4; }
  sleep 0.02
done
# task 212: cleanup is EXIT-only — EXIT fires however the process exits. INT/TERM
# must call `exit` themselves: a handler that doesn't exit RESUMES at the next
# statement, so a bare cleanup on INT/TERM would free the lock early and then run
# the model call anyway (the two-callers-in-one-thread race this lock exists to
# prevent). 130/143 = 128+signal.
trap 'rm -rf "$lock"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# test hook (task 212): hold the post-lock window open — lock acquired, traps
# installed — so the deterministic SIGTERM test can prove a signal actually
# STOPS the process instead of freeing the lock early and running the bridge.
# Gated behind AGENT_BRIDGE_TEST_MODE=1.
if [ "${AGENT_BRIDGE_TEST_MODE:-}" = 1 ] && [ -n "${AGENT_BRIDGE_POST_LOCK_DELAY:-}" ]; then
  sleep "${AGENT_BRIDGE_POST_LOCK_DELAY}"
fi

AGENT_BRIDGE_DEPTH=$((depth + 1))
export AGENT_BRIDGE_DEPTH

# ── Run Pi under a watchdog ────────────────────────────────────────────────
# (the AGENT_BRIDGE_DEPTH line above is the end of the lock block — case 7 of
# ask-bridge-lock.test.sh extracts the lock block up to it, so keep everything
# below it.)
# Two hangs this guards against:
#  1. Pi reads stdin to EOF whenever stdin is not a TTY. Agent harnesses hand
#     us a pipe that never closes, so Pi sat at startup forever: 0% CPU, no
#     socket, no session file. Fixed by </dev/null (Pi's stdin is /dev/null).
#  2. Pi finishes (agent_settled) but something keeps its event loop alive, so
#     the process never exits and the caller waits for hours.
# Pi runs in --mode json: every streamed token is an event, which gives a real
# liveness signal. The final reply is extracted from the events.
# KEEP IN SYNC: ask-claude carries the same </dev/null fix.
idle_limit="${PI_BRIDGE_IDLE_SECS:-600}"     # no events AND no CPU in Pi's tree
max_runtime="${PI_BRIDGE_MAX_SECS:-7200}"    # hard cap
settle_grace="${PI_BRIDGE_SETTLE_SECS:-30}"  # quiet this long after agent_settled = done
logdir="$HOME/.pi/agent/bridge-logs"; mkdir -p "$logdir"
events="$(mktemp "${TMPDIR:-/tmp}/ask-pi-events.XXXXXX")"
pi_pid=""

# CPU centiseconds used by a process plus all descendants (tool runs count).
tree_cpu() {
  ps -A -o pid=,ppid=,time= | awk -v root="$1" '
    { n=split($3,a,":"); s=0; for(i=1;i<=n;i++) s=s*60+a[i]
      cpu[$1]=int(s*100); kids[$2]=kids[$2]" "$1 }
    END { q[1]=root; n=1; tot=0
      for (i=1; i<=n; i++) { tot+=cpu[q[i]]
        m=split(kids[q[i]],c," "); for (j=1; j<=m; j++) q[++n]=c[j] }
      print tot }'
}
kill_pi() {   # every command guarded: set -e would abort mid-kill otherwise
  [ -n "$pi_pid" ] && kill -0 "$pi_pid" 2>/dev/null || return 0
  disown "$pi_pid" 2>/dev/null || true   # no "Killed: 9" job notice
  pkill -TERM -P "$pi_pid" 2>/dev/null || true; kill -TERM "$pi_pid" 2>/dev/null || true
  for _ in 1 2 3 4 5; do kill -0 "$pi_pid" 2>/dev/null || return 0; sleep 1; done
  # Pi's SIGTERM handler awaits extension dispose, which is the part that hangs.
  pkill -KILL -P "$pi_pid" 2>/dev/null || true; kill -KILL "$pi_pid" 2>/dev/null || true
  return 0
}
save_log() {
  # Keep everything except per-token deltas, to diagnose the next hang.
  # grep -v exits 1 when no lines are kept (e.g. an empty events file on the
  # stalled path); under set -e that would abort the EXIT trap before rm -rf
  # "$lock" and overwrite the exit code, so guard it — logging is best-effort.
  grep -v '"type":"message_update"' "$events" >> "$logdir/${session}.jsonl" 2>/dev/null || true
  rm -f "$events"
}
trap 'kill_pi; save_log; rm -rf "$lock"' EXIT

pi "$@" --mode json "$msg" </dev/null >"$events" &
pi_pid=$!

start=$(date +%s); last_change=$start; last_size=-1; last_cpu=-1; verdict=""
while kill -0 "$pi_pid" 2>/dev/null; do
  sleep 5
  now=$(date +%s)
  size=$(wc -c <"$events" | tr -d ' ')
  cpu=$(tree_cpu "$pi_pid")
  if [ "$size" != "$last_size" ] || [ "$cpu" -gt $((last_cpu + 5)) ]; then
    last_change=$now; last_size=$size; last_cpu=$cpu
  fi
  quiet=$((now - last_change))
  if [ "$quiet" -ge "$settle_grace" ] && tail -c 4096 "$events" | grep -q '"type":"agent_settled"'; then
    verdict="settled"; break
  elif [ "$quiet" -ge "$idle_limit" ]; then
    verdict="stalled"; break
  elif [ $((now - start)) -ge "$max_runtime" ]; then
    verdict="timeout"; break
  fi
done

pi_status=0
if [ -z "$verdict" ]; then
  wait "$pi_pid" || pi_status=$?
else
  kill_pi
fi
elapsed=$(( $(date +%s) - start ))

# Final assistant reply → stdout; provider error → stderr (exit 1); none → exit 3.
reply_status=0
python3 - "$events" <<'PY' || reply_status=$?
import json, sys
last = None
for line in open(sys.argv[1], errors="replace"):
    try: ev = json.loads(line)
    except ValueError: continue
    m = ev.get("message") or {}
    if ev.get("type") == "message_end" and m.get("role") == "assistant":
        last = m
if last is None:
    sys.exit(3)
if last.get("stopReason") in ("error", "aborted"):
    print(last.get("errorMessage") or "Request %s" % last.get("stopReason"), file=sys.stderr)
    sys.exit(1)
print("\n".join(c["text"] for c in last.get("content", []) if c.get("type") == "text"))
PY

resume_hint="resume with: ask-pi -t ${thread} \"continue — check git log/status first\""
case "$verdict" in
  settled)
    echo "ask-pi: Pi finished but did not exit; watchdog stopped it ${settle_grace}s later. Reply above is complete." >&2
    exit "$reply_status" ;;
  stalled)
    echo "ask-pi: STALLED — no output and no CPU from Pi for ${idle_limit}s (ran ${elapsed}s). Killed. Session ${session}; ${resume_hint}" >&2
    exit 124 ;;
  timeout)
    echo "ask-pi: TIMEOUT — hit the ${max_runtime}s hard cap. Killed. Session ${session}; ${resume_hint}" >&2
    exit 124 ;;
esac
[ "$reply_status" -eq 3 ] && echo "ask-pi: Pi exited (${pi_status}) without a reply. Events: $logdir/${session}.jsonl" >&2
[ "$pi_status" -ne 0 ] && exit "$pi_status"
exit "$reply_status"
