#!/usr/bin/env bash
# lane — claim a work lane and print a paste-ready coordinates block.
#
# A lane is one agent + one session + one set of files it is allowed to touch.
# Run this when you set up a task list; paste the printed block into the other
# window so both sides know where they are and who owns what.
#
#   lane who [path]      # list live Claude sessions + lanes in a tree (read-only)
#   lane new scraper --owns tools/rugby-shop-scraper
#   lane new pricing --worktree feat/catalog-pricing --owns vendors/pricing
#   lane new pair --share-worktree   # deliberate two-writer pairing (task 107)
#   lane review 154       # = lane new review/154 --owns pr/154 (task 109)
#   lane reviews 154      # pre-merge check: list claims of pr/154 + STATE
#   lane ls
#   lane rm scraper
#   lane prune [--apply] [--all]   # list lanes nobody holds; --apply drops their rows
#
# `lane prune` lists a lane whose session is not live and whose branch is
# merged into origin/main, whose branch is gone, or whose worktree folder is
# missing. A Pi lane (state unknown) is listed only when its branch or its
# worktree folder is gone — a merged branch alone is not enough, because its
# liveness cannot be observed. A live lane is never listed; `--all` also shows
# the lanes it keeps and why. `--apply` removes the listed registry rows only,
# never a worktree or a branch (it prints the `git worktree remove` hint).
#
# The registry lives in the repo's shared git dir, so every worktree of the
# same repo sees the same lanes. It is never committed.
set -euo pipefail

die() { echo "lane: $*" >&2; exit 1; }

# Resolve a symlink chain to the real file before locating lib/: run through a
# link in ~/bin, $BASH_SOURCE is the link, not the checkout that holds lib/.
# Inline, because no helper can be sourced until we know where we are, and
# portable: macOS has no `readlink -f`. The same block belongs at the top of
# every bridge script that locates its siblings; keep the copies identical.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _self_dir="$(CDPATH= cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  case "$_self" in /*) ;; *) _self="${_self_dir}/${_self}" ;; esac
done
script_dir="$(CDPATH= cd -P "$(dirname "$_self")" && pwd)"
# Shared session/tree/registry primitives (task 154, "shared core, not a
# copy"): canon, canon_full, tree_of, is_live, session_fields, session_by_id, short_id,
# review_only, reg_rows, lane_common_dir/lane_registry_path. `lane-guard`
# sources the same file so the two never drift into two implementations of
# "who is live" or "what tree is this".
source "${script_dir}/lib/lane-core.sh"
# task 200: the shared main-checkout root (dirname of the git-common-dir), so
# `lane new --worktree` puts the worktree in one place however it was invoked.
source "${script_dir}/lib/repo-root.sh"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git repo"
common="$(lane_common_dir)"
REG="$(lane_registry_path)"

# Live Claude sessions come from session files, one JSON per session, with keys
# pid, sessionId, cwd, name, status. Tests and callers can point this elsewhere.
sessions_dir="${LANE_SESSIONS_DIR:-$HOME/.claude/sessions}"

# claimant_name <sessionId> — the session's name, else "the claiming session".
claimant_name() {
  local sid="$1" pid cid cwd name status
  IFS=$'\t' read -r pid cid cwd name status <<< "$(session_by_id "$sid")"
  if [ -n "$name" ]; then printf '%s' "$name"; else printf '%s' 'the claiming session'; fi
}

# claimant_state <claimed_by> <agent> — live | STALE | unknown, the exact
# resolution `lane ls` prints for a claimant. Never fails.
claimant_state() {
  local claimed="$1" agent="$2" pid sid cwd name status
  if [ -n "$claimed" ]; then
    IFS=$'\t' read -r pid sid cwd name status <<< "$(session_by_id "$claimed")"
    if [ -n "$sid" ]; then
      if [ -n "$pid" ] && is_live "$pid"; then printf 'live'; else printf 'STALE'; fi
    elif [ "$agent" = "pi" ]; then
      printf 'unknown'
    else
      printf 'STALE'
    fi
  else
    printf 'unknown'
  fi
}

# holder_for <dir> — if another live session holds <dir> (a live Claude session's
# cwd resolves to that tree, or a lane claims that dir with a live claimant),
# print "DESC<TAB>NAME" (holder description + the name to SendMessage to). Empty
# when not held. Never fails.
holder_for() {
  local dir="$1" tree me f pid sid cwd name status
  tree="$(tree_of "$dir")"
  me="${CLAUDE_CODE_SESSION_ID:-}"
  if [ -n "$tree" ]; then
    for f in "$sessions_dir"/*.json; do
      [ -f "$f" ] || continue
      IFS=$'\t' read -r pid sid cwd name status <<< "$(session_fields "$f")"
      [ -n "$pid" ] || continue
      [ -n "$sid" ] || continue
      [ "$sid" != "$me" ] || continue
      is_live "$pid" || continue
      [ -n "$cwd" ] || continue
      [ "$(tree_of "$cwd")" = "$tree" ] || continue
      printf 'session %s [%s] (pid %s)\t%s\t%s\n' "$name" "$(short_id "$sid")" "$pid" "$name" "$sid"
      return 0
    done
  fi
  local r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed
  while IFS=$'\t' read -r r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed; do
    [ -n "$r_name" ] || continue
    [ -n "$r_claimed" ] || continue
    [ "$r_claimed" != "$me" ] || continue
    ! review_only "$r_owns" || continue   # a review claim holds a PR, not a tree (task 109)
    # canon_full, not canon: two DIFFERENT missing dirs must not collapse to a
    # shared parent and read as the same tree (task 233).
    [ "$(canon_full "$r_dir")" = "$(canon_full "$dir")" ] || continue
    local cpid csid ccwd cname cstatus
    IFS=$'\t' read -r cpid csid ccwd cname cstatus <<< "$(session_by_id "$r_claimed")"
    [ -n "$cpid" ] || continue
    is_live "$cpid" || continue
    printf 'lane %s (claimed by %s [%s])\t%s\t%s\n' "$r_name" "$cname" "$(short_id "$csid")" "$cname" "$csid"
    return 0
  done <<< "$(reg_rows)"
  return 0
}

lane_who() {
  local path="${1:-.}" tree c f pid sid cwd name status you found
  tree="$(tree_of "$path")"
  if [ -z "$tree" ]; then
    echo "lane: no git work tree at '$path'" >&2
    return 0
  fi
  echo "tree: $tree"
  echo
  echo "live Claude sessions in this tree:"
  found=0
  for f in "$sessions_dir"/*.json; do
    [ -f "$f" ] || continue
    IFS=$'\t' read -r pid sid cwd name status <<< "$(session_fields "$f")"
    [ -n "$pid" ] || continue
    [ -n "$sid" ] || continue
    is_live "$pid" || continue
    [ -n "$cwd" ] || continue
    c="$(canon "$cwd")"
    case "$c/" in
      "$tree"/*) : ;;
      *) [ "$c" = "$tree" ] || continue ;;
    esac
    you=""
    [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ "$sid" = "$CLAUDE_CODE_SESSION_ID" ] && you="  (you)"
    printf '  %-28s %s  pid %-8s %s%s\n' "$name" "$(short_id "$sid")" "$pid" "$status" "$you"
    found=1
  done
  [ "$found" = 1 ] || echo "  (none)"
  echo
  echo "lanes in this tree:"
  found=0
  local r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed
  while IFS=$'\t' read -r r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed; do
    [ -n "$r_name" ] || continue
    [ -n "$r_dir" ] || continue
    [ "$(canon_full "$r_dir")" = "$tree" ] || continue
    printf '  %-28s (agent %s, branch %s)\n' "$r_name" "$r_agent" "$r_branch"
    found=1
  done <<< "$(reg_rows)"
  [ "$found" = 1 ] || echo "  (none)"
  return 0
}

lane_ls() {
  local rows; rows="$(reg_rows)"
  [ -n "$rows" ] || { echo "no lanes claimed in this repo"; return 0; }
  printf '%-14s %-7s %-26s %-7s %-28s %s\n' NAME AGENT SESSION STATE BRANCH OWNS
  local r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed
  while IFS=$'\t' read -r r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed; do
    [ -n "$r_name" ] || continue
    local sess state pid sid cwd name status
    state="$(claimant_state "$r_claimed" "$r_agent")"
    if [ -n "$r_claimed" ]; then
      IFS=$'\t' read -r pid sid cwd name status <<< "$(session_by_id "$r_claimed")"
      if [ -n "$sid" ]; then
        sess="${name:-<unnamed>} [$(short_id "$sid")]"
      else
        # A Pi claimant's id is a Pi/bridge session, never in Claude's session
        # files — its liveness is not observable here, so say so, not STALE.
        sess="$(short_id "$r_claimed")"
      fi
    else
      sess="-"
    fi
    printf '%-14s %-7s %-26s %-7s %-28s %s\n' "$r_name" "$r_agent" "$sess" "$state" "$r_branch" "${r_owns:-<whole repo>}"
  done <<< "$rows"
}

lane_rm() {
  local target="${1:?usage: lane rm <name>}" tmp
  grep -q "^${target}$(printf '\t')" "$REG" || die "no lane named '$target'"
  tmp="$(mktemp)"; grep -v "^${target}$(printf '\t')" "$REG" > "$tmp"; mv "$tmp" "$REG"
  echo "released lane '$target' (any git worktree it used is left in place — remove with: git worktree remove <path>)"
}

# lane_usage — print this file's leading comment block as help. Reads the `#`
# lines after the shebang and stops at the first non-comment, so a new
# command's help line does not mean editing a line count here.
lane_usage() {
  awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
}

# lane prune [--apply] [--all] — list the lanes nobody holds and, with --apply,
# remove exactly those registry rows. A lane is listed only when its session is
# not live AND one of:
#
#   - its branch tip is an ancestor of origin/main as last fetched (STALE
#     lanes only: a Pi lane's liveness is not observable, so a merged branch
#     alone must never remove it);
#   - its branch no longer exists;
#   - its worktree folder is missing.
#
# A live lane is never listed. `--all` also lists the lanes it keeps and why.
# A branch that IS the default branch is never called merged (it is trivially
# merged into itself). `--apply` removes registry rows only, the way `lane rm`
# does — never a worktree, never a branch.
lane_prune() {
  local apply=0 all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --apply) apply=1; shift ;;
      --all)   all=1; shift ;;
      -h|--help) lane_usage; return 0 ;;
      *) die "usage: lane prune [--apply] [--all]" ;;
    esac
  done

  local main_sha default_branch root
  git rev-parse --verify --quiet origin/main >/dev/null 2>&1 \
    || die "origin/main not found — fetch first; prune compares against origin/main as last fetched"
  main_sha="$(git rev-parse --short origin/main)"
  # The MAIN checkout, not this worktree: sessions normally run from a linked
  # worktree, and the shared main checkout's dirt must not be attributed to a
  # worktree-lane row — nor a worktree-lane row skipped because it IS this
  # worktree. agent_bridge_root resolves git-common-dir, the same anchor
  # `lane new --worktree` uses (a `--show-toplevel` here would be the invoking
  # worktree's root, which is exactly the wrong tree).
  root="$(agent_bridge_root 2>/dev/null)" || root=""
  [ -n "$root" ] || root="$(git rev-parse --show-toplevel)"
  root="$(canon_full "$root")"
  # The default branch can never be "merged into itself". Resolve its name from
  # origin/HEAD; fall back to main when origin/HEAD is not set.
  default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)" || default_branch=""
  default_branch="${default_branch#origin/}"
  [ -n "$default_branch" ] || default_branch="main"

  echo "lane prune: comparing against origin/main (${main_sha}, as last fetched)"
  printf '%-28s %-7s %-7s %-24s %s\n' NAME AGENT STATE BRANCH REASON

  # Tab is IFS *whitespace* in bash, so `read` collapses a row whose `owns`
  # field is empty (`lane new foo` with no --owns) and shifts every later field
  # left — a live Claude lane then reads as `unknown` and can be pruned. Swap the
  # separator for a non-whitespace control character so an empty field stays a
  # field. (The same collapse lives in `lane ls`/`holder_for`; fixing those is a
  # separate change — prune is the one that acts destructively on the parse.)
  local rows; rows="$(reg_rows | tr '\t' '\037')"
  local r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed
  local cand_names="" n=0
  while IFS=$'\037' read -r r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed; do
    [ -n "$r_name" ] || continue
    local state reasons="" keep="" branch_exists=0 no_branch=0 merged=0
    local dir_exists=0 dirty=0
    state="$(claimant_state "$r_claimed" "$r_agent")"
    [ "$state" = live ] && continue
    # One review per PR (task 109): a lane that owns ANY pr/<n> claims a review —
    # the same predicate `lane reviews` and merge-pr.sh use — and a review claim
    # is never auto-removed; it is cancelled explicitly with `lane rm`. Pruning it
    # would silently open merge-pr.sh's "no review outstanding" gate. `review_only`
    # (all-pr owns) is too narrow: a mixed `--owns pr/154 --owns tools/x` still
    # locks pr/154.
    case " ${r_owns//,/ } " in
      *" pr/"*)
        [ "$all" = 1 ] && printf '%-28s %-7s %-7s %-24s %s\n' "$r_name" "$r_agent" "$state" "$r_branch" \
          "kept: review claim — cancel with \`lane rm $r_name\` first"
        continue ;;
    esac
    case "$r_branch" in ""|HEAD) no_branch=1 ;; esac
    if [ "$no_branch" = 0 ] && git show-ref --verify --quiet "refs/heads/$r_branch"; then branch_exists=1; fi
    if [ -n "$r_dir" ] && [ -d "$r_dir" ]; then dir_exists=1; fi
    # "Merged" is the branch tip being an ancestor of origin/main. `main` itself
    # and the origin/HEAD branch are never called merged: they are trivially
    # merged into themselves, and origin/HEAD is not guaranteed to name main.
    if [ "$no_branch" = 0 ] && [ "$branch_exists" = 1 ] \
       && [ "$r_branch" != main ] && [ "$r_branch" != "$default_branch" ] \
       && git merge-base --is-ancestor "refs/heads/$r_branch" origin/main 2>/dev/null; then
      # Only now is dirt relevant. A linked worktree with uncommitted work is not
      # "merged": `lane new --worktree` points the branch at the current HEAD, so
      # until the first commit the tip IS origin/main. --no-optional-locks: prune
      # is read-only and must not drop an index.lock in a worktree a live worker
      # may be using.
      if [ "$dir_exists" = 1 ] && [ "$(canon_full "$r_dir")" != "$root" ] \
         && [ -n "$(git --no-optional-locks -C "$r_dir" status --porcelain 2>/dev/null)" ]; then
        dirty=1
      else
        merged=1
      fi
    fi
    # Conservative for Pi: its liveness is not observable — state `unknown`, or a
    # `--agent pi` row whose Claude claimant's session file has gone stale while
    # the Pi worker may still run. A merged branch alone never lists such a lane.
    if [ "$state" = unknown ] || [ "$r_agent" = pi ]; then
      [ "$no_branch" = 0 ] && [ "$branch_exists" = 0 ] && reasons="${reasons}branch no longer exists; "
      [ "$dir_exists" = 0 ] && reasons="${reasons}worktree folder missing; "
    else
      [ "$merged" = 1 ] && reasons="${reasons}branch merged into origin/main; "
      [ "$no_branch" = 0 ] && [ "$branch_exists" = 0 ] && reasons="${reasons}branch no longer exists; "
      [ "$dir_exists" = 0 ] && reasons="${reasons}worktree folder missing; "
    fi
    if [ -n "$reasons" ]; then
      reasons="${reasons%; }"
      printf '%-28s %-7s %-7s %-24s %s\n' "$r_name" "$r_agent" "$state" "$r_branch" "$reasons"
      if [ -z "$cand_names" ]; then cand_names="$r_name"; else cand_names="${cand_names}
${r_name}"; fi
      n=$((n + 1))
    elif [ "$all" = 1 ]; then
      if [ "$no_branch" = 1 ]; then
        keep="kept: no branch recorded (detached HEAD)"
      elif [ "$dirty" = 1 ]; then
        keep="kept: worktree has uncommitted changes"
      elif [ "$r_branch" = "$default_branch" ]; then
        keep="kept: '${r_branch}' is the default branch — never treated as merged"
      elif [ "$state" = unknown ] || [ "$r_agent" = pi ]; then
        keep="kept: Pi lane (state unknown) — a merged branch alone is not enough"
      else
        keep="kept: branch unmerged and worktree exists"
      fi
      printf '%-28s %-7s %-7s %-24s %s\n' "$r_name" "$r_agent" "$state" "$r_branch" "$keep"
    fi
  done <<< "$rows"

  if [ "$apply" = 1 ] && [ "$n" -gt 0 ]; then
    local tmp names cname dupes reg_mode=""
    # Temp file beside the registry, so `mv` is an atomic same-filesystem replace
    # (a $TMPDIR temp could be cross-device, and lane-guard reads this file on
    # every write).
    # ponytail: still an unlocked read-modify-write shared with `lane rm`; a
    # concurrent `lane new` append inside the tiny window can be lost.
    tmp="$(mktemp "${REG}.XXXXXX")" || die "could not create a temp registry beside $REG"
    # Read the registry's mode numerically: `stat -c` on Linux, `stat -f` on
    # macOS. A symbolic `ls -l` string carries an ACL marker ("-rw-r--r--@")
    # that chmod refuses, so it must never be fed to chmod.
    reg_mode="$(stat -c '%a' "$REG" 2>/dev/null)" || reg_mode=""
    [ -n "$reg_mode" ] || reg_mode="$(stat -f '%Lp' "$REG" 2>/dev/null)" || reg_mode=""
    names="$(mktemp)" || { rm -f "$tmp"; die "could not create a temp name list"; }
    printf '%s\n' "$cand_names" > "$names"
    # Two rows with one candidate name mean the check-then-append gate was
    # bypassed; dropping both would not be "exactly the listed rows".
    dupes="$(awk -F'\t' 'NR==FNR { k[$1]=1; next } ($1 in k) { c[$1]++ } END { for (n in c) if (c[n] > 1) print n }' "$names" "$REG")"
    if [ -n "$dupes" ]; then
      rm -f "$tmp" "$names"
      die "registry has duplicate rows for: $(printf '%s' "$dupes" | tr '\n' ' ')— resolve by hand before --apply"
    fi
    # Drop exactly the listed rows, the way `lane rm` does: registry only.
    if ! awk -F'\t' 'NR==FNR { k[$1]=1; next } !($1 in k)' "$names" "$REG" > "$tmp"; then
      rm -f "$tmp" "$names"
      die "could not rewrite the registry"
    fi
    # mktemp creates the file 0600; keep the registry's own mode across the
    # replace. A failure here is not hidden: the mode would silently change.
    if [ -n "$reg_mode" ]; then
      chmod "$reg_mode" "$tmp" \
        || echo "lane: warning: could not set mode $reg_mode on $tmp — $REG may change mode" >&2
    else
      echo "lane: warning: could not read the mode of $REG — it may change mode across --apply" >&2
    fi
    mv "$tmp" "$REG"
    rm -f "$names"
    while IFS= read -r cname; do
      [ -n "$cname" ] || continue
      echo "released lane '$cname' (any git worktree it used is left in place — remove with: git worktree remove <path>)"
    done <<< "$cand_names"
    return 0
  fi
  if [ "$n" -gt 0 ]; then
    echo "$n lane(s) would be pruned; re-run with --apply to remove their registry rows"
  else
    echo "no lanes to prune"
  fi
}

# Warn when a new lane's paths overlap one already claimed. Prefix match both
# ways, so `vendors` vs `vendors/pricing` is caught.
check_overlap() {
  # NOTE: every variable here is local and r_-prefixed on purpose. `read` in a
  # loop overwrites caller variables of the same name, and blanks them at EOF.
  local newname="$1" newowns="$2" hit=0
  local r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed a b
  [ -n "$newowns" ] || { reg_rows | grep -q . && echo "  ⚠ this lane claims the WHOLE repo while other lanes exist — expect collisions" >&2; return 0; }
  while IFS=$'\t' read -r r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed; do
    [ -n "$r_name" ] && [ "$r_name" != "$newname" ] || continue
    [ -n "$r_owns" ] || { echo "  ⚠ lane '$r_name' claims the whole repo — it overlaps you" >&2; hit=1; continue; }
    for a in ${newowns//,/ }; do
      for b in ${r_owns//,/ }; do
        case "$a/" in "$b/"*) echo "  ⚠ '$a' is inside lane '$r_name' ($b)" >&2; hit=1 ;; esac
        case "$b/" in "$a/"*) echo "  ⚠ lane '$r_name' ($b) is inside your '$a'" >&2; hit=1 ;; esac
      done
    done
  done <<< "$(reg_rows)"
  [ "$hit" -eq 0 ] || echo "  → pick disjoint paths, or give one of the lanes its own --worktree" >&2
}

# one review per PR (task 109, CEO 2026-09-24): a lane whose owns includes
# pr/<n> claims a NUMBER, not a path — and a PR has exactly one reviewer. Refuse
# (exit 3) any claim whose pr/<n> is already owned by another lane. No override
# flag, and nothing is auto-removed: a dead or unobservable claimant still holds
# the claim until it is cancelled explicitly with `lane rm`.
check_review_claim() {
  local newname="$1" newowns="$2"
  local r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed a pr
  for a in ${newowns//,/ }; do
    case "$a" in pr/*) : ;; *) continue ;; esac
    pr="${a#pr/}"
    while IFS=$'\t' read -r r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed; do
      [ -n "$r_name" ] || continue
      [ -n "$r_owns" ] || continue
      case " ${r_owns//,/ } " in *" pr/$pr "*) : ;; *) continue ;; esac
      local state pid sid cwd cname cstatus
      state="$(claimant_state "$r_claimed" "$r_agent")"
      if [ "$state" = "live" ]; then
        IFS=$'\t' read -r pid sid cwd cname cstatus <<< "$(session_by_id "$r_claimed")"
        echo "lane: review of PR $pr is already claimed by ${cname:-<unnamed>} [$(short_id "${sid:-$r_claimed}")] — reviews are 1:1 with a PR (task 109)." >&2
      else
        echo "lane: review of PR $pr is already claimed, but the claimant is gone (or its liveness is unknown) — cancel it explicitly with \`lane rm ${r_name}\` first (task 109)." >&2
      fi
      return 3
    done <<< "$(reg_rows)"
  done
  return 0
}

# review_claim_lock <pr> — the mkdir lock for pr/<n>, ask-pi's thread-lock shape
# (task 156). mkdir success is the ONLY thing that ever means "I hold the lock":
# the pid is published with a temp-file + mv (atomic on one filesystem), so a
# racer never sees a freshly-made lock whose pid file is torn or absent. On a
# lost mkdir, only a pid file that names a demonstrably dead process is
# reclaimed; an absent/unreadable pid means someone is mid-acquisition, so we
# back off and retry a bounded number of times instead of rm -rf'ing under them.
review_claim_lock() {
  local pr="$1" lock pidfile holder tmpfile i=0
  lock="${common}/.lane-review-${pr}.lock"
  pidfile="${lock}/pid"
  while :; do
    if mkdir "$lock" 2>/dev/null; then
      # test hook (task 156): hold the mkdir→pid-write window open so the
      # deterministic race test can prove a racer backs off and never reclaims.
      # Gated behind LANE_TEST_MODE=1 so a stray env var in a real shell cannot
      # silently widen the lock window.
      if [ "${LANE_TEST_MODE:-}" = 1 ] && [ -n "${LANE_TEST_LOCK_DELAY:-}" ]; then
        sleep "${LANE_TEST_LOCK_DELAY}"
      fi
      tmpfile="${lock}/pid.$$"
      echo $$ > "$tmpfile"
      mv "$tmpfile" "$pidfile" 2>/dev/null || { rm -rf "$lock"; echo "lane: cannot lock pr/$pr" >&2; exit 3; }
      return 0
    fi
    holder="$(cat "$pidfile" 2>/dev/null || true)"
    if [ -n "$holder" ]; then
      if kill -0 "$holder" 2>/dev/null; then
        echo "lane: review of PR $pr is being claimed right now (pid $holder) — retry in a moment (task 109)." >&2
        exit 3
      fi
      rm -rf "$lock"                     # stale: the pid named a dead process
      continue
    fi
    # pid absent/unreadable: the holder is still mid-acquisition — back off.
    i=$((i + 1))
    [ "$i" -le 250 ] || { echo "lane: cannot lock pr/$pr (still being acquired after $i retries)" >&2; exit 3; }
    sleep 0.02
  done
}

lane_new() {
  local name="" agent="" owns="" wt="" wt_branch="" share=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --owns)           owns="${owns}${owns:+,}$2"; shift 2 ;;
      --agent)          agent="$2"; shift 2 ;;
      --share-worktree) share=1; shift ;;
      --worktree)       wt=1; case "${2-}" in -*|"") wt_branch="" ;; *) wt_branch="$2"; shift ;; esac; shift ;;
      -*)               die "unknown flag $1" ;;
      *)                [ -z "$name" ] && name="$1" || die "unexpected arg $1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "usage: lane new <name> [--agent pi|claude] [--worktree [branch]] [--owns <path>]... [--share-worktree]"

  # Agent attribution (task 107): explicit --agent wins; else claude when this
  # process is inside a Claude session, else pi, else refuse to guess.
  if [ -z "$agent" ]; then
    if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then agent="claude"
    elif [ -n "${PI_SESSION_ID:-}" ]; then agent="pi"
    else die "usage: lane new requires --agent when neither CLAUDE_CODE_SESSION_ID nor PI_SESSION_ID is set"; fi
  fi

  # task 156: the check-then-append below is two registry touches that must not
  # interleave. Take ask-pi's mkdir thread-lock (one per pr/<n>) in the shared
  # git dir and hold it until the append at the end of this function, so two
  # same-instant claims of one PR cannot both pass check_review_claim.
  # Deliberately NOT `local`: the EXIT trap below fires after this function
  # returns, and a `local` var is out of scope by then — the trap would see an
  # empty string and release nothing. Do not add `local` here; it silently
  # reintroduces the lock leak task 156 closed, and none of tests 19-22 would
  # catch it (they only exercise refusal/race paths, not a winning claim's
  # cleanup on the ordinary success path).
  lane_lockdirs=""
  # task 156: install signal/exit handling ONCE, before the first lock is taken.
  # Cleanup is EXIT-only — EXIT fires however the process exits, and it reads
  # ${lane_lockdirs} at fire time, so every lock grabbed (including a later one
  # in a multi-pr --owns list) is released even on a mid-loop refusal. INT/TERM
  # must call `exit` themselves: a trap handler that doesn't exit RESUMES at the
  # next statement after the signal, so a bare cleanup trap on INT/TERM would
  # free the lock early and then keep running to append the row (the two-winners
  # race task 156 closes, reopened through Ctrl-C). 130/143 = 128+signal.
  trap 'for l in ${lane_lockdirs}; do rm -rf "$l" 2>/dev/null; done' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  local l_own l_pr seen_prs=""
  for l_own in ${owns//,/ }; do
    case "$l_own" in
      pr/*)
        l_pr="${l_own#pr/}"
        case "$l_pr" in
          ''|*[!0-9]*) echo "lane: pr/<n> must be numeric, got '$l_own'" >&2; exit 64 ;;
        esac
        # task 156: dedupe pr/<n> — a duplicate would re-enter review_claim_lock
        # for the same PR, read its OWN pid, and self-refuse with a misleading
        # "already claimed by another" message.
        case " $seen_prs " in *" $l_pr "*) continue ;; esac
        seen_prs="${seen_prs} $l_pr"
        review_claim_lock "$l_pr"
        lane_lockdirs="${lane_lockdirs} ${common}/.lane-review-${l_pr}.lock"
        ;;
    esac
  done

  # test hook (task 156): hold the post-lock window open — lock acquired, traps
  # installed — so the deterministic SIGTERM test can prove a signal actually
  # STOPS the process instead of freeing the lock early and resuming to append.
  # Gated behind LANE_TEST_MODE=1 so a stray env var in a real shell cannot
  # silently pause a real claim.
  if [ "${LANE_TEST_MODE:-}" = 1 ] && [ -n "${LANE_TEST_POST_LOCK_DELAY:-}" ] && [ -n "$lane_lockdirs" ]; then
    sleep "${LANE_TEST_POST_LOCK_DELAY}"
  fi

  # one review per PR (task 109, CEO 2026-09-24): a second claim of pr/<n> is
  # refused outright — it names the live holder or demands an explicit `lane rm`.
  check_review_claim "$name" "$owns" || exit 3

  grep -q "^${name}$(printf '\t')" "$REG" && die "lane '$name' already exists (lane ls)"

  local root repo dir branch claimed_by main_root
  root="$(canon "$(git rev-parse --show-toplevel)")"
  # task 200: anchor `repo` and a --worktree's dir to the MAIN checkout, not the
  # invoking worktree. agent_bridge_root resolves the shared main-checkout root
  # from the git-common-dir, so `lane new --worktree` lands at the same
  # <main-parent>/<repo>-<name> path however it was invoked — run from inside a
  # nested worktree, the old `dirname root` nested the new worktree under that
  # worktree instead. Fall back to this worktree's root if resolution fails.
  main_root="$(agent_bridge_root 2>/dev/null)" || main_root=""
  if [ -n "$main_root" ]; then main_root="$(canon "$main_root")"; else main_root="$root"; fi
  repo="$(basename "$main_root")"

  if [ -n "$wt" ]; then
    wt_branch="${wt_branch:-lane/${name}}"
    dir="$(dirname "$main_root")/${repo}-${name}"
  else
    dir="$root"
  fi

  # one-writer-per-tree (task 107, CEO 2026-09-24): refuse to claim a tree held
  # by another live session, unless --share-worktree says the pairing is
  # deliberate. Read-only co-tenancy is fine; only the write-claim is gated.
  claimed_by="${CLAUDE_CODE_SESSION_ID:-${PI_SESSION_ID:-}}"
  local holder_line="" holder_desc holder_name holder_sid
  # A review claim (owns only pr/<n>) edits no tree, so the tree gate does not apply (task 109).
  review_only "$owns" || holder_line="$(holder_for "$dir")"
  if [ -n "$holder_line" ]; then
    IFS=$'\t' read -r holder_desc holder_name holder_sid <<< "$holder_line"
    if [ "$share" = 1 ]; then
      echo "lane: WARNING: ${holder_desc} holds ${dir} — bypassing the one-writer-per-tree rule (task 107, CEO 2026-09-24)." >&2
      echo "lane: tell them: SendMessage to \"${holder_name}\"" >&2
      # task 154: the holder is told too, once per co-tenant — not just this
      # session's own warning. A notice in the holder's queue, delivered by
      # `lane-guard notices` on its next prompt/tool call.
      lane_notify_holder "$holder_sid" "is sharing" "$(claimant_name "$claimed_by")" "$(short_id "$claimed_by")" "$dir" || true
    else
      echo "lane: refusing to claim ${dir}: held by ${holder_desc}." >&2
      echo "lane: two live windows writing one tree is the task 107 hazard — if this pairing is deliberate, re-run with --share-worktree." >&2
      exit 3
    fi
  fi

  if [ -n "$wt" ]; then
    if [ -d "$dir" ]; then
      echo "reusing existing worktree at $dir"
    elif git show-ref --verify --quiet "refs/heads/${wt_branch}"; then
      git worktree add "$dir" "$wt_branch" >&2
    else
      git worktree add -b "$wt_branch" "$dir" >&2
    fi
    branch="$wt_branch"
  else
    branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD)"
  fi

  echo "checking for collisions with existing lanes…" >&2
  check_overlap "$name" "$owns"

  # claimed_by = the agent session that ran `lane new`. ask-pi/ask-claude use it
  # to default their bridge thread to THIS session's lane, so two sessions in one
  # worktree cannot silently share the default thread.
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$name" "$agent" "$name" "$dir" "$branch" "$owns" "$(date +%Y-%m-%d)" \
    "$claimed_by" >> "$REG"

  # linked worktree iff the claimed dir's --git-dir differs from --git-common-dir
  # (resolved and canonical), whatever flag was (or wasn't) passed. A caller who
  # is ALREADY inside a linked worktree gets "linked worktree" without --worktree.
  local is_wt=0 gd cgd
  gd="$(git -C "$dir" rev-parse --git-dir 2>/dev/null)" || gd=""
  cgd="$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null)" || cgd=""
  case "$gd" in /*) ;; *) gd="$dir/$gd" ;; esac
  case "$cgd" in /*) ;; *) cgd="$dir/$cgd" ;; esac
  [ "$(canon "$gd")" != "$(canon "$cgd")" ] && is_wt=1

  local opencmd reach_label reach_cmd guard worktree_line
  if [ "$agent" = "claude" ]; then
    opencmd="cd ${dir} && claude"
    reach_label="reach it from another Claude window"
    reach_cmd="SendMessage to \"$(claimant_name "$claimed_by")\""
  else
    opencmd="cd ${dir} && pi --session-id ${name} -n \"${name}\""
    reach_label="reach it from Claude Code (separate thread, does not touch the window's session)"
    reach_cmd="ask-pi -t ${name} \"<message>\""
  fi
  if [ "$is_wt" = 1 ]; then
    worktree_line="yes — linked worktree"; [ -n "$wt" ] && worktree_line="yes — linked worktree — --worktree always lands at $(dirname "$main_root")/${repo}-<name>"
    guard="own worktree — commit freely on ${branch}"
  elif [ -n "$owns" ]; then
    worktree_line="no — shared main checkout"
    guard="SHARED checkout — commit ONLY paths under: ${owns}. Never \`git add -A\`."
  else
    worktree_line="no — shared main checkout"
    guard="SHARED checkout, no owned paths declared — re-run with --owns before editing anything."
  fi

  cat <<EOF

━━━━━━━━━━ LANE: ${name} ━━━━━━━━━━
directory   ${dir}
session id  ${name}
worktree    ${worktree_line}
branch      ${branch}
owns        ${owns:-<not declared>}
agent       ${agent}

open this lane in a new terminal window:
  ${opencmd}

${reach_label}:
  ${reach_cmd}

rule: ${guard}
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

EOF
}

# lane review <pr> — sugar for `lane new review/<pr> --owns pr/<pr>` (task 109):
# a review claims the PR number, not a path — it edits nothing.
lane_review() {
  local pr="${1:?usage: lane review <pr>}"
  [ $# -eq 1 ] || die "usage: lane review <pr>"
  case "$pr" in *[!0-9]*) die "lane review <pr>: PR must be a number" ;; esac
  lane_new "review/$pr" --owns "pr/$pr"
}

# lane reviews <pr> — read-only pre-merge check: list every claim of pr/<n>
# with its STATE (live | STALE | unknown, same as `lane ls`). Exit 0 when no
# claim is open, 1 when any claim exists (the PR must not merge).
lane_reviews() {
  local pr="${1:?usage: lane reviews <pr>}" found=0
  [ $# -eq 1 ] || die "usage: lane reviews <pr>"
  case "$pr" in *[!0-9]*) die "lane reviews <pr>: PR must be a number" ;; esac
  local r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed
  while IFS=$'\t' read -r r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed; do
    [ -n "$r_name" ] || continue
    [ -n "$r_owns" ] || continue
    case " ${r_owns//,/ } " in *" pr/$pr "*) : ;; *) continue ;; esac
    found=1
    local state sess pid sid cwd name status
    state="$(claimant_state "$r_claimed" "$r_agent")"
    if [ -n "$r_claimed" ]; then
      IFS=$'\t' read -r pid sid cwd name status <<< "$(session_by_id "$r_claimed")"
      if [ -n "$sid" ]; then sess="${name:-<unnamed>} [$(short_id "$sid")]"; else sess="$(short_id "$r_claimed")"; fi
    else
      sess="-"
    fi
    printf '%-16s %-7s %s\n' "$r_name" "$state" "$sess"
  done <<< "$(reg_rows)"
  if [ "$found" = 1 ]; then
    echo "lane: review of PR $pr is still claimed — it must report before the PR merges (task 109)." >&2
    return 1
  fi
  echo "no review claimed for PR $pr"
  return 0
}

case "${1-}" in
  new)     shift; lane_new "$@" ;;
  review)  shift; lane_review "$@" ;;
  reviews) shift; lane_reviews "$@" ;;
  who)     shift; lane_who "$@" ;;
  ls|"")   lane_ls ;;
  rm)      shift; lane_rm "$@" ;;
  prune)   shift; lane_prune "$@" ;;
  -h|--help) lane_usage ;;
  *)     die "unknown command '${1}' (new | review | reviews | who | ls | rm | prune)" ;;
esac
