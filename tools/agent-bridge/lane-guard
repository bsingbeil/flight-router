#!/usr/bin/env bash
# lane-guard — Claude Code hook: the per-write half of task 107's CEO
# decision that task 107 itself left undone. `lane new` only guards the
# CLAIM; nothing stopped a session that never claimed anything from simply
# editing a tree another live session holds. This is that stop.
#
# Which session holds a tree is task 154's question and ticket 332's: a live
# lane claim holds it; without one, the MAIN checkout is held by a session that
# wrote there inside the last 30 minutes (an idle window holds nothing), and a
# linked worktree by the earliest-started session. README.md, "Who holds a tree
# when there is no claim", states the rule and the order of the refusal.
#
#   lane-guard pre       # PreToolUse, matcher Edit|Write|MultiEdit|NotebookEdit|Bash
#   lane-guard notices    # UserPromptSubmit and PostToolUse
#
# Registered in .claude/settings.json (project scope — Brendan's ruling on
# task 154, 2026-09-28: a hook that runs on every edit proves itself where a
# bug only affects one repo; it can move to user scope later).
#
# FAIL OPEN. Any internal error here — jq missing, an unreadable registry, a
# hook JSON that won't parse, a corrupt session file — allows the write and
# prints one stderr line. A hook that fails CLOSED blocks every edit in
# every session; that is a worse hazard than the one this guards against.
# There is deliberately no `set -e`: a failing command here must fall
# through to an explicit allow, never abort mid-decision.
set -uo pipefail

# Resolve a symlink chain to the real file before locating lib/: run through a
# link in ~/bin, $BASH_SOURCE is the link, not the checkout that holds lib/.
# Inline, because no helper can be sourced until we know where we are, and
# portable: macOS has no `readlink -f`. The same block belongs at the top of
# every bridge script that locates its siblings; keep the copies identical.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _self_dir="$(CDPATH= cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  case "$_self" in /*) ;; *) _self="${_self_dir}/${_self}" ;; esac
done
script_dir="$(CDPATH= cd -P "$(dirname "$_self")" && pwd)"
# Shared session/tree/registry primitives — the same lib `lane` sources, so
# "who is live" and "what tree is this" can never drift into two answers.
source "${script_dir}/lib/lane-core.sh"

sessions_dir="${LANE_SESSIONS_DIR:-$HOME/.claude/sessions}"

# The write window (ticket 332): in the main checkout a session holds the tree
# only while it has written there inside this many minutes. ONE named value, so
# a test can shorten it instead of forging old timestamps.
write_window_min="${LANE_GUARD_WRITE_WINDOW_MINUTES:-30}"
case "$write_window_min" in '' | *[!0-9]* | 0) write_window_min=30 ;; esac

# bash_write_ish <command> — heuristic: does this Bash command look like it
# writes to disk? On a match it prints the NAME of the pattern that matched and
# returns 0; with no match it prints nothing and returns 1. The refusal names
# the printed pattern, so a session can see why its command counted (ticket
# 344).
#
# Deliberately imprecise in both directions (a `>` inside a quoted grep pattern
# is a false positive; a write hidden behind a wrapper script is a false
# negative) — this gates a hook that must stay fast and fail open, not a
# security boundary. A command that doesn't match is never refused, so a false
# negative here is silent; a false positive just costs one extra holder check,
# which is cheap.
bash_write_ish() {
  local c=" $1 " entry label pat
  # `2>&1` and `2>/dev/null` are NOT writes: they send stderr to stdout or to
  # the void, so a read-only command that carries one must not be refused in a
  # tree another session holds (ticket 344). Strip exactly those two forms, then
  # test the rest of the rule unchanged — every other `>` still counts, a bare
  # `> /dev/null`, `1>/dev/null` and `2> /dev/null` included.
  case "$c" in
    *'2>&1'* | *'2>/dev/null'*)
      c="$(printf '%s' "$c" | sed -e 's/2>&1//g' -e 's|2>/dev/null||g')" ;;
  esac
  # label:pattern — one entry per form that counts, each pattern spelled exactly
  # as the case arms it replaces read it (surrounding spaces included: ` rm `
  # must not match `form`). `>` is first, so the commonest write names itself.
  # `[[ $c == *$pat* ]]`, not a `case` arm: bash 3.2 does not match an unquoted
  # variable in a case-arm position, and a bare `>` there is a syntax error.
  for entry in \
    '>:>' 'tee: tee ' 'sed -i:*sed*-i*' 'perl -i:*perl*-i*' \
    'mv: mv ' 'cp: cp ' 'rm: rm ' 'mkdir: mkdir ' 'touch: touch ' 'chmod: chmod ' 'ln: ln ' \
    'git add: git add' 'git commit: git commit' 'git checkout: git checkout' \
    'git switch: git switch' 'git reset: git reset' 'git restore: git restore' \
    'git merge: git merge' 'git rebase: git rebase' 'git cherry-pick: git cherry-pick' \
    'git revert: git revert' 'git stash: git stash' 'git apply: git apply' \
    'git am: git am' 'git pull: git pull' 'git clean: git clean' \
    'git rm: git rm' 'git mv: git mv'
  do
    label="${entry%%:*}"
    pat="${entry#*:}"
    # shellcheck disable=SC2053   # the unquoted $pat is a pattern on purpose
    if [[ $c == *$pat* ]]; then printf '%s' "$label"; return 0; fi
  done
  return 1
}

# lane_guard_load_sessions — pid\tsessionId\tcwd\tname\tstatus\tstartedAt per
# parseable file in $sessions_dir. Tries ONE batched `jq -s` call across
# every file (one fork, not one per file — the latency budget in task 154's
# design note 5) and falls back to a per-file loop, skipping whatever jq
# can't parse, only if the batch call fails outright (one corrupt file
# poisons a slurp of everything). The fallback is also the fail-open path
# for a corrupt session file: a file that can't be read just isn't in the
# result, which is what "fail open" wants (a holder we can't see can't
# block a write).
lane_guard_load_sessions() {
  local out=""
  shopt -s nullglob
  local files=("$sessions_dir"/*.json)
  shopt -u nullglob
  [ "${#files[@]}" -gt 0 ] || return 0
  out="$(jq -rs '.[] | [(.pid//""),(.sessionId//""),(.cwd//""),(.name//""),(.status//""),(.startedAt//"")]|@tsv' "${files[@]}" 2>/dev/null)"
  if [ $? -eq 0 ] && [ -n "$out" ]; then
    printf '%s\n' "$out"
    return 0
  fi
  local f row
  for f in "${files[@]}"; do
    row="$(jq -r '[(.pid//""),(.sessionId//""),(.cwd//""),(.name//""),(.status//""),(.startedAt//"")]|@tsv' "$f" 2>/dev/null)" || continue
    [ -n "$row" ] && printf '%s\n' "$row"
  done
  return 0
}

# in_tree_sessions <tree> — the rows of $sessions_tsv whose cwd is <tree> or
# inside it, by raw string-prefix match (the `"$cwd/"` in `"$tree"/*` idiom
# that `lane who` uses, so a sibling like /repo2 is not counted as inside
# /repo). No canon(): Claude Code records session cwd as getcwd(3), i.e. the
# already-symlink-resolved physical path, so the two strings are already in the
# same canonical form. One pass over $sessions_tsv, no git forks — this is the
# task 154 latency fix (the tiebreak used to re-run `tree_of` — a git fork —
# per session per function, ~1.5 s over ~31 sessions).
in_tree_sessions() {
  local tree="$1"
  local s_pid s_sid s_cwd s_name s_status s_started
  while IFS=$'\t' read -r s_pid s_sid s_cwd s_name s_status s_started; do
    [ -n "$s_pid" ] || continue
    [ -n "$s_sid" ] || continue
    [ -n "$s_cwd" ] || continue
    case "$s_cwd/" in
      "$tree"/*) : ;;
      *) [ "$s_cwd" = "$tree" ] || continue ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$s_pid" "$s_sid" "$s_cwd" "$s_name" "$s_status" "$s_started"
  done <<< "$sessions_tsv"
}

# claimant_info <sessionId> — "pid<TAB>name" for a session id, from the
# already-loaded $sessions_tsv, one awk pass. Empty if unknown.
claimant_info() { printf '%s\n' "$sessions_tsv" | awk -F'\t' -v want="$1" '$2==want{print $1 "\t" $4; exit}'; }

# claims_on_tree <tree> — the live, non-review lane claims on <tree>, as
# name<TAB>claimed_by<TAB>claimant_name<TAB>claimant_short. Computed ONCE per
# invocation (cmd_pre stores it in $tree_claims): the tiebreak and the refusal
# message all read this instead of re-scanning the registry and re-resolving
# each claimant's liveness (which was the second latency sink after the
# per-session tree_of — a real registry has ~15 rows).
claims_on_tree() {
  local tree="$1"
  local r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed
  while IFS=$'\t' read -r r_name r_agent r_session r_dir r_branch r_owns r_created r_claimed; do
    [ -n "$r_name" ] || continue
    [ -n "$r_claimed" ] || continue
    review_only "$r_owns" && continue
    # Raw string compare, no canon(): `lane new` stores a canonical dir
    # (canon of --show-toplevel, or dirname of it + a literal name), so the
    # registry value is already in the same form as $tree (from `git
    # rev-parse --show-toplevel`).
    [ "$r_dir" = "$tree" ] || continue
    local info pid cname
    info="$(claimant_info "$r_claimed")"
    pid="${info%%$'\t'*}"; cname="${info#*$'\t'}"
    [ -n "$pid" ] || continue
    is_live "$pid" || continue
    printf '%s\t%s\t%s\t%s\n' "$r_name" "$r_claimed" "${cname:-?}" "$(short_id "$r_claimed")"
  done <<< "$(reg_rows)"
}

# has_live_claim_by <sessionId> — a live, non-review lane claim on this tree
# whose claimed_by is exactly <sessionId>. Reads the precomputed $tree_claims.
# This is rule (a) of the tiebreak, and it is also what makes a
# --share-worktree pairing work on BOTH sides: each side's OWN claim satisfies
# this independently, so neither needs to be "the" single holder.
has_live_claim_by() {
  local id="$1"
  local c_name c_claimed c_cname c_cshort
  while IFS=$'\t' read -r c_name c_claimed c_cname c_cshort; do
    [ -n "$c_name" ] || continue
    [ "$c_claimed" = "$id" ] && return 0
  done <<< "$tree_claims"
  return 1
}

# any_live_claim_on_tree — true if ANY live, non-review lane claims this tree,
# regardless of who. Rule (b) only applies with no claim at all.
any_live_claim_on_tree() { [ -n "$tree_claims" ]; }

# earliest_started_session_in_tree — the sessionId of the live session in
# $tree_sessions (already filtered to this tree by cmd_pre) with the smallest
# startedAt, among those that HAVE one. A session file with no startedAt counts
# as latest-started (task 154, clarification 1) — it can never win this. When
# NOTHING in the tree has startedAt this prints empty: the tiebreak has no
# winner, which is_holder treats as "nobody is refused" (fail open, not mutual
# refusal).
earliest_started_session_in_tree() {
  local best_sid="" best_started=""
  local s_pid s_sid s_cwd s_name s_status s_started
  while IFS=$'\t' read -r s_pid s_sid s_cwd s_name s_status s_started; do
    [ -n "$s_pid" ] || continue
    [ -n "$s_sid" ] || continue
    is_live "$s_pid" || continue
    [ -n "$s_started" ] || continue
    if [ -z "$best_started" ] || { [ "$s_started" -lt "$best_started" ] 2>/dev/null; }; then
      best_sid="$s_sid"; best_started="$s_started"
    fi
  done <<< "$tree_sessions"
  printf '%s' "$best_sid"
}

# ---- the write record (ticket 332) ------------------------------------------
# In the main checkout a session holds the tree only while it has written there
# inside the window, so the hook has to remember when each session last wrote.
# The record is <git-common-dir>/lane-writes.tsv: inside the shared git dir (so
# the registry, the notices and this record sit in one place, shared by every
# worktree of the repo) and never in the work tree, so it is never committed.
# One row per allowed write, "<epoch><TAB><sessionId>", appended, so a session's
# LAST row is its newest write. Rows older than the window are ignored when read.
# The file is rewritten (below) once it passes write_record_max_rows: that drops
# the rows outside the window and keeps ONE row per live holder, so it never
# grows past that bound and a session that quits ages out of it. A record that
# cannot be read or appended prints one line and changes no decision (fail open).
WRITE_RECORD_MAX_ROWS=64
writes_tsv=""
write_rows_n=0
write_holders_tsv=""
write_holder_rows=""
write_holder_facts=""; write_holder_sid=""; write_holder_name=""
holder_facts=""; holder_sid=""; holder_name=""

# lane_guard_load_writes <file> <now> <window_min> — set $writes_tsv to the rows
# inside the window and $write_rows_n to how many rows the file held. Never
# fails.
lane_guard_load_writes() {
  local file="$1" now="$2" window="$3" cutoff ts sid kept=""
  writes_tsv=""
  write_rows_n=0
  case "$now" in '' | *[!0-9]*) return 0 ;; esac
  [ -f "$file" ] || return 0
  if [ ! -r "$file" ]; then
    echo "lane-guard: cannot read the write record — allowing (fail open)." >&2
    return 0
  fi
  cutoff=$(( now - window * 60 ))
  while IFS=$'\t' read -r ts sid; do
    write_rows_n=$(( write_rows_n + 1 ))
    case "$ts" in '' | *[!0-9]*) continue ;; esac
    [ -n "$sid" ] || continue
    [ "$ts" -ge "$cutoff" ] || continue
    kept="${kept}${ts}"$'\t'"${sid}"$'\n'
  done < "$file"
  writes_tsv="$kept"
  return 0
}

# lane_guard_compact_writes <file> — once the record passes
# $WRITE_RECORD_MAX_ROWS, replace it with one row per live holder ($write_holder_rows,
# built by write_holders): the rows outside the window and every duplicate row go.
# Rewriting costs one `mv`, so it happens roughly once per 64 writes, not per
# call. ponytail: no lock; a row appended between the read and the move can be
# lost, and a lost row loses a hold, which allows a write — the fail-open
# direction. The bound is what keeps that window rare.
lane_guard_compact_writes() {
  local file="$1"
  local tmp="${file}.$$.tmp"
  [ "${write_rows_n:-0}" -gt "$WRITE_RECORD_MAX_ROWS" ] || return 0
  if printf '%s' "$write_holder_rows" > "$tmp" 2>/dev/null && mv "$tmp" "$file" 2>/dev/null; then
    return 0
  fi
  rm -f "$tmp" 2>/dev/null
  return 0
}

# lane_guard_record_write <file> <sessionId> <now> — append this allowed write.
lane_guard_record_write() {
  local file="$1" sid="$2" now="$3"
  case "$now" in '' | *[!0-9]*) now=0 ;; esac   # no clock → a row nobody counts
  if ! printf '%s\t%s\n' "$now" "$sid" >> "$file" 2>/dev/null; then
    echo "lane-guard: cannot record this write — allowing (fail open)." >&2
  fi
  return 0
}

# write_holders — set $write_holders_tsv ("sessionId<TAB>minutesAgo" per LIVE
# session that wrote inside the window), $write_holder_rows (the newest row of
# each of them, for the compaction) and, in the same pass, part 1 of the
# refusal's fact: $write_holder_facts / _$sid / _$name. A dead session's
# row must not hold a tree: that would be the idle-window block this rule exists
# to end, only after a crash. Empty $write_holders_tsv means NOBODY holds the
# tree. Pure bash over the two short lists (the record holds a handful of rows,
# the sessions a few dozen), so neither path forks anything new.
write_holders() {
  local -a rows=()
  local n=0 ts sid i j pid name m unit
  local s_pid s_sid s_cwd s_name s_status s_started
  write_holders_tsv=""; write_holder_rows=""
  write_holder_facts=""; write_holder_sid=""; write_holder_name=""
  [ -n "$writes_tsv" ] || return 0
  while IFS=$'\t' read -r ts sid; do
    [ -n "$sid" ] || continue
    rows[$n]="${ts}"$'\t'"${sid}"
    n=$(( n + 1 ))
  done <<< "$writes_tsv"
  # Walking the rows BACKWARDS makes each session's newest write the first one
  # seen for it — the record only appends, so the last row wins.
  for (( i = n - 1; i >= 0; i-- )); do
    sid="${rows[$i]#*$'\t'}"
    ts="${rows[$i]%%$'\t'*}"
    for (( j = i + 1; j < n; j++ )); do
      [ "${rows[$j]#*$'\t'}" = "$sid" ] && continue 2   # a newer row for this session
    done
    pid=""; name=""
    while IFS=$'\t' read -r s_pid s_sid s_cwd s_name s_status s_started; do
      [ "$s_sid" = "$sid" ] || continue
      pid="$s_pid"; name="$s_name"; break
    done <<< "$sessions_tsv"
    [ -n "$pid" ] || continue          # a session we cannot see cannot hold
    is_live "$pid" || continue
    m=$(( (write_now - ts) / 60 )); [ "$m" -ge 0 ] || m=0
    write_holders_tsv="${write_holders_tsv}${sid}"$'\t'"${m}"$'\n'
    write_holder_rows="${write_holder_rows}${ts}"$'\t'"${sid}"$'\n'
    unit=minutes; [ "$m" = 1 ] && unit=minute
    write_holder_facts="${write_holder_facts:+$write_holder_facts; }session ${name:-?} [$(short_id "$sid")] wrote here ${m} ${unit} ago"
    [ -n "$write_holder_sid" ] || { write_holder_sid="$sid"; write_holder_name="${name:-?}"; }
  done
  return 0
}

# holds_by_recent_write <sessionId> — true when it holds the main checkout by a
# write inside the window. Reads the precomputed $write_holders_tsv (a string
# match: no loop, no fork, nothing to read).
holds_by_recent_write() {
  case $'\n'"$write_holders_tsv" in
    *$'\n'"$1"$'\t'*) return 0 ;;
  esac
  return 1
}

# is_holder <sessionId> — (a) a live claim by <sessionId> makes it a holder
# outright, unchanged; (b) otherwise: in the MAIN checkout <sessionId> holds
# while it has written there inside the window (ticket 332) — and a recent write
# keeps holding BESIDE someone else's claim, so a --share-worktree pairing adds
# a writer instead of displacing one; in a linked worktree, ONLY if no live claim
# exists on this tree at all, the earliest-started live session there holds it
# (task 154's tiebreak, kept for worktrees).
is_holder() {
  local id="$1"
  has_live_claim_by "$id" && return 0
  if [ "$tree_is_main" = 1 ]; then
    holds_by_recent_write "$id"
    return
  fi
  any_live_claim_on_tree && return 1
  local earliest; earliest="$(earliest_started_session_in_tree)"
  # No startedAt anywhere in the tree → the earliest-started tiebreak has no
  # winner, so nobody is refused on that basis (task 154 fix: fail open — an
  # empty tiebreak must allow, never refuse every session at once).
  [ -z "$earliest" ] && return 0
  [ "$id" = "$earliest" ]
}

# write_allowed <sessionId> — the allow/refuse decision itself.
write_allowed() {
  local id="$1"
  is_holder "$id" && return 0
  # A live claim holds the tree and this session is not its claimant; rule (b)
  # does not apply at all (ticket 332: a lane claim still wins).
  any_live_claim_on_tree && return 1
  if [ "$tree_is_main" = 1 ]; then
    # Nobody wrote inside the window → nobody holds the tree, so there is
    # nothing to refuse (task 332: an idle window no longer blocks the checkout).
    [ -z "$write_holders_tsv" ]
    return
  fi
  ! other_present "$id"
}

# other_present <sessionId> — true if some session OTHER than <sessionId> is
# live in this tree (by cwd) or holds a live claim on it. The third way to be
# allowed to write is that nobody else is around at all.
other_present() {
  local me="$1"
  local s_pid s_sid s_cwd s_name s_status s_started
  while IFS=$'\t' read -r s_pid s_sid s_cwd s_name s_status s_started; do
    [ -n "$s_pid" ] || continue
    [ -n "$s_sid" ] || continue
    [ "$s_sid" != "$me" ] || continue
    is_live "$s_pid" || continue
    return 0
  done <<< "$tree_sessions"
  local c_name c_claimed c_cname c_cshort
  while IFS=$'\t' read -r c_name c_claimed c_cname c_cshort; do
    [ -n "$c_name" ] || continue
    [ "$c_claimed" != "$me" ] || continue
    return 0
  done <<< "$tree_claims"
  return 1
}

# build_holder_facts <sessionId> — for the refusal MESSAGE only (the
# allow/refuse decision never calls this). Sets $holder_facts to one clause per
# holding session, joined "; ", and $holder_sid / $holder_name to the first of
# them (whom the notice and part 4 name). Part 1 of Brendan's order is "the
# fact: which session wrote there, and how many minutes ago" (2026-10-12), so
# each clause names the session and its age; a lane claim is the fact when a
# claim is what holds the tree. Never fails; empty when no holder can be named.
build_holder_facts() {
  local me="$1" facts="" c_name c_claimed c_cname c_cshort sid cname
  holder_facts=""; holder_sid=""; holder_name=""
  if [ -n "$tree_claims" ]; then
    while IFS=$'\t' read -r c_name c_claimed c_cname c_cshort; do
      [ -n "$c_name" ] || continue
      [ "$c_claimed" = "$me" ] && continue
      facts="${facts:+$facts; }session ${c_cname:-?} [${c_cshort}] holds this tree by lane ${c_name}"
      [ -n "$holder_sid" ] || { holder_sid="$c_claimed"; holder_name="${c_cname:-?}"; }
    done <<< "$tree_claims"
  fi
  # A recent writer holds too, beside a claim (see is_holder): name it as well.
  if [ "$tree_is_main" = 1 ] && [ -n "$write_holder_facts" ]; then
    facts="${facts:+$facts; }${write_holder_facts}"
    [ -n "$holder_sid" ] || { holder_sid="$write_holder_sid"; holder_name="$write_holder_name"; }
  elif [ "$tree_is_main" != 1 ] && [ -z "$facts" ]; then
    sid="$(earliest_started_session_in_tree)"
    if [ -n "$sid" ] && [ "$sid" != "$me" ]; then
      cname="$(claimant_info "$sid")"; cname="${cname#*$'\t'}"
      facts="session ${cname:-?} [$(short_id "$sid")] is the earliest-started session in this tree"
      holder_sid="$sid"; holder_name="${cname:-?}"
    fi
  fi
  holder_facts="$facts"
}

# lane_guard_cleanup_notices — opportunistic (task 154, design note 2): a
# lane-notices/<sid> queue file and its <sid>.seen dedupe file are deleted
# once <sid> has no live session at all. Best effort, never fails, never
# affects this call's own allow/refuse decision.
lane_guard_cleanup_notices() {
  local dir
  dir="$(lane_notices_dir 2>/dev/null)" || return 0
  [ -d "$dir" ] || return 0
  local f base sid pid
  for f in "$dir"/*; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    sid="${base%.seen}"
    pid="$(claimant_info "$sid")"; pid="${pid%%$'\t'*}"
    if [ -z "$pid" ] || ! is_live "$pid"; then
      rm -f "${dir}/${sid}" "${dir}/${sid}.seen" 2>/dev/null
    fi
  done
  return 0
}

cmd_pre() {
  local payload
  payload="$(cat)"
  if [ -z "$payload" ]; then
    echo "lane-guard: empty hook input — allowing (fail open)." >&2
    exit 0
  fi
  if ! command -v jq >/dev/null 2>&1; then
    echo "lane-guard: jq not found — allowing (fail open)." >&2
    exit 0
  fi

  local session_id cwd tool_name file_path notebook_path command write_why=""
  # One jq call for the single-line fields, joined on \x1f (a separator paths
  # and commands never contain) so empty fields survive `read` — a tab
  # delimiter would collapse the empty file_path/notebook_path fields.
  IFS=$'\x1f' read -r session_id cwd tool_name file_path notebook_path <<< "$(printf '%s' "$payload" | jq -r '[.session_id//"",.cwd//"",.tool_name//"",.tool_input.file_path//"",.tool_input.notebook_path//""]|join("\u001f")' 2>/dev/null)"
  # `command` is pulled separately: it is the one field that can carry embedded
  # newlines, and `read` stops at the first \n — joining it into the single-line
  # read silently truncated a multi-line Bash command before bash_write_ish ever
  # saw the write on line 2 (task 154 fix: the exact write the guard exists to
  # block slipped through).
  command="$(printf '%s' "$payload" | jq -r '.tool_input.command // ""' 2>/dev/null)"
  if [ -z "$session_id" ]; then
    echo "lane-guard: hook input had no session_id — allowing (fail open)." >&2
    exit 0
  fi

  # Target tree: the git tree of dirname(file_path or notebook_path); for
  # Bash, of cwd, and only for a command that looks like a write.
  local dir=""
  case "$tool_name" in
    Edit|Write|MultiEdit)
      [ -n "$file_path" ] && dir="$(dirname "$file_path")"
      ;;
    NotebookEdit)
      [ -n "$notebook_path" ] && dir="$(dirname "$notebook_path")"
      ;;
    Bash)
      # On a match, keep WHICH pattern matched — the refusal names it (ticket 344).
      write_why="$(bash_write_ish "$command")" || exit 0   # read-only Bash is never refused
      dir="$cwd"
      ;;
    *)
      exit 0 ;;   # a tool this guard doesn't watch
  esac
  [ -n "$dir" ] || exit 0

  local d out tree common REG sessions_tsv tree_sessions tree_claims
  local tree_is_main=0 write_now=""
  d="$(canon "$dir")"
  # One git call for both the tree root and the shared git dir (the hook runs
  # on every edit; two `rev-parse` forks were ~20 ms of the latency budget).
  out="$(git -C "$d" rev-parse --show-toplevel --git-common-dir 2>/dev/null)" || out=""
  tree="${out%%$'\n'*}"
  [ -n "$tree" ] || exit 0   # not inside a git work tree — allow
  common="${out#*$'\n'}"
  # --git-common-dir is relative (".git") in a main checkout; resolve against
  # the tree, then canonicalise (the main checkout's .git is not a symlink, but
  # a linked worktree's common dir path can be).
  case "$common" in /*) ;; *) common="$tree/$common" ;; esac
  common="$(canon "$common")"
  REG=""
  [ -f "${common}/lanes.tsv" ] && REG="${common}/lanes.tsv"
  sessions_tsv="$(lane_guard_load_sessions)"
  tree_sessions="$(in_tree_sessions "$tree")"
  tree_claims="$(claims_on_tree "$tree")"

  # Main checkout or linked worktree (ticket 332): a main checkout's .git is a
  # real directory; a linked worktree's (and a submodule's) is a file pointing
  # into the shared git dir. The write window applies to the main checkout only
  # — a linked worktree keeps task 154's earliest-started rule.
  tree_is_main=0
  [ -d "${tree}/.git" ] && tree_is_main=1
  write_now="$(date +%s 2>/dev/null)"
  case "$write_now" in '' | *[!0-9]*) write_now="" ;; esac
  # The record is read in the main checkout even beside a claim: a recent write
  # is a hold of its own there, so a share claim adds a writer rather than
  # displacing one. A linked worktree reads no record (its rule is task 154's).
  if [ "$tree_is_main" = 1 ]; then
    lane_guard_load_writes "${common}/lane-writes.tsv" "$write_now" "$write_window_min"
    write_holders
    lane_guard_compact_writes "${common}/lane-writes.tsv"
  fi

  lane_guard_cleanup_notices

  if write_allowed "$session_id"; then
    # Record the write so the next call can see it. Only the main checkout's
    # rule reads the record, so only its writes go in it — a worktree would
    # just litter the shared file with rows no rule reads.
    [ "$tree_is_main" = 1 ] \
      && lane_guard_record_write "${common}/lane-writes.tsv" "$session_id" "$write_now"
    exit 0
  fi

  # Refused. Name every holder for the message, and tell the first of them —
  # once per (cotenant, tree) — that someone just tried to write here.
  build_holder_facts "$session_id"

  local info cname cshort
  info="$(claimant_info "$session_id")"
  cname="${info#*$'\t'}"
  cshort="$(short_id "$session_id")"
  if [ -n "$holder_sid" ]; then
    lane_notify_holder "$holder_sid" "tried to write in" "${cname:-the writing session}" "$cshort" "$tree"
  fi

  {
    # Brendan's four-part order (2026-10-12, task 299; ticket 332). Part 1 is
    # the fact — which session wrote there, and how many minutes ago — and
    # ticket 344's "which pattern matched" stays INSIDE it (Brendan,
    # 2026-10-16). Parts 2 to 4 are the way out, least disruptive first.
    printf 'lane-guard: refusing this write — %s' "${holder_facts:-another live session in this tree}"
    [ -n "$write_why" ] && printf '; your command counts as a write because of `%s`' "$write_why"
    printf '.\n'
    echo "lane-guard: work in your own worktree folder — \`lane ls\` lists them."
    echo "lane-guard: if you must write here, take a share claim and name the files you own — \`lane new <name> --share-worktree --owns <path>\`."
    echo "lane-guard: message the holder — SendMessage to \"${holder_name:-the holder}\"."
  } >&2
  exit 2
}

cmd_notices() {
  local payload
  payload="$(cat)"
  [ -n "$payload" ] || exit 0
  command -v jq >/dev/null 2>&1 || exit 0

  local session_id event
  session_id="$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)"
  [ -n "$session_id" ] || exit 0
  event="$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null)"
  [ -n "$event" ] || event="PostToolUse"

  local dir
  dir="$(lane_notices_dir 2>/dev/null)" || exit 0
  local file="${dir}/${session_id}"
  [ -s "$file" ] || exit 0

  local body
  body="$(cat "$file" 2>/dev/null)"
  [ -n "$body" ] || exit 0

  rm -f "$file" 2>/dev/null   # delivered — remove the lines this call takes

  jq -n --arg event "$event" --arg ctx "$body" \
    '{hookSpecificOutput:{hookEventName:$event, additionalContext:$ctx}}' 2>/dev/null
  exit 0
}

case "${1-}" in
  pre)     shift; cmd_pre "$@" ;;
  notices) shift; cmd_notices "$@" ;;
  *)       echo "lane-guard: unknown mode '${1-}' (pre|notices) — allowing (fail open)." >&2; exit 0 ;;
esac
