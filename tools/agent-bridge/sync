#!/usr/bin/env bash
# sync — push the canonical agent-bridge scripts to every repo that mirrors them.
#
# This directory is canonical; ~/bin symlinks here. The mirrors exist so the
# tooling survives losing this checkout. Run after changing any script, then
# commit AND push the repos this names.
#
# A mirror is current when its PUSHED copy matches canonical: each file under
# tools/agent-bridge/ at the mirror's origin default branch (fetched first).
# The backup is what is on the remote, not whatever branch a checkout happens
# to have out — a checkout parked on another session's feature branch says
# nothing about whether the mirror exists.
#
#   sync                    copy into each STALE mirror's working tree, report what changed
#                           (PARKED, not written: checkout off the default branch, not
#                           at its origin tip, or tools/agent-bridge/ dirty — use a
#                           throwaway worktree, or --via-worktree)
#   sync --check            report only, change nothing (exit 1 if anything is stale)
#   sync --via-worktree     push each STALE mirror that sync parks through a throwaway
#                           worktree off its origin default branch: copy the scripts,
#                           commit one fixed message naming the canonical commit, push.
#                           Prints one line per mirror (PUSHED / CURRENT / FAIL), never
#                           touches the mirror's own checkout, and removes the worktree on
#                           every exit path. A stale mirror that is not parked is copied
#                           into its working tree as plain sync does (the person still
#                           commits it). Exits 1 if any mirror is not current when it
#                           finishes (failed, still only copied, diverged, or no origin),
#                           the same convention as --check; exits 64 on bad usage. Plain
#                           sync and --check are unchanged.
#
# SYNC_TARGETS (space-separated paths) replaces the target list — for tests.
set -euo pipefail

# Resolve a symlink chain to the real file before locating lib/: run through a
# link in ~/bin, $BASH_SOURCE is the link, not the checkout that holds lib/.
# Inline, because no helper can be sourced until we know where we are, and
# portable: macOS has no `readlink -f`. The same block belongs at the top of
# every bridge script that locates its siblings; keep the copies identical.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _self_dir="$(CDPATH= cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  case "$_self" in /*) ;; *) _self="${_self_dir}/${_self}" ;; esac
done
SRC="$(CDPATH= cd -P "$(dirname "$_self")" && pwd)"
# Generic bridge tooling only. orchestrator-count.sh and check-task-filed.sh
# are deliberately NOT here: both hardcode navigate-ops' tasks/inbox +
# tasks/done layout and its PR conventions, so a mirror target would end up
# counting THAT repo's unrelated files and reporting nonsense. See README.md
# "What sync mirrors, and what it doesn't".
SCRIPTS=(
  ask-pi ask-claude lane lane-guard README.md sync
  dispatch.sh
  lib/frontmatter.sh lib/lane-core.sh lib/portable-date.sh lib/repo-root.sh
)

TARGETS=(
  /Users/bsingbeil/Sites/infrastructure
  /Users/bsingbeil/Sites/cool-pet-beds
  /Users/bsingbeil/Sites/energy-storage
  /Users/bsingbeil/Sites/flight-router
  /Users/bsingbeil/Sites/heat-pump
  /Users/bsingbeil/Sites/hk-imports
  /Users/bsingbeil/Sites/design
)
# shellcheck disable=SC2206  # word-splitting the override is the point
[ -n "${SYNC_TARGETS:-}" ] && TARGETS=($SYNC_TARGETS)

check_only=0
via_worktree=0
case "${1-}" in
  "") ;;
  --check) check_only=1 ;;
  --via-worktree) via_worktree=1 ;;
  *) echo "sync: unknown argument: ${1-} (see the usage comment at the top)" >&2; exit 64 ;;
esac
[ "$#" -gt 1 ] && { echo "sync: unexpected argument: $2" >&2; exit 64; }

stale=0 copied=0 skipped=0 pushed=0 failed=0

# --- --via-worktree (task 293): a stale mirror whose own checkout is off its
# default branch, behind its origin tip, or dirty under tools/agent-bridge/
# cannot be written in place. Add a throwaway detached worktree at the mirror's
# origin default branch, copy the scripts there, commit one fixed message
# naming the canonical commit, and push to that branch. The mirror's own
# checkout, branch and working files are never touched; the worktree is removed
# on every exit path; nothing is forced, so a rejected push is a FAIL that
# leaves the remote alone.
wt_target=""; wt_tmp=""
# The last non-blank line of a command's captured output, for a FAIL reason.
tail_line() { printf '%s\n' "$1" | awk 'NF { l = $0 } END { if (l != "") print l }'; }
cleanup_worktree() {
  [ -n "$wt_tmp" ] || return 0
  if ! git -C "$wt_target" worktree remove --force "$wt_tmp" >/dev/null 2>&1; then
    # remove failed: delete the throwaway directory first, then prune — prune
    # only drops an entry whose directory is already gone. No prune on the
    # normal path: it would also drop every other mirror worktree whose
    # directory is missing.
    rm -rf "$wt_tmp" 2>/dev/null || true
    git -C "$wt_target" worktree prune >/dev/null 2>&1 || true
  fi
  rm -rf "$wt_tmp" 2>/dev/null || true
  wt_tmp=""
  return 0
}
[ "$via_worktree" -eq 1 ] && trap cleanup_worktree EXIT

fail() { echo "FAIL     $1  ($2: $3)"; failed=$((failed + 1)); cleanup_worktree; }

push_parked() {
  local target="$1" ref="$2" branch="${2#origin/}" canonical tmp out f copy_failed=0 reason
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/sync-wt.XXXXXX")" ||
    { echo "FAIL     $target  ($ref: cannot create a temp dir)"; failed=$((failed + 1)); return 0; }
  wt_target="$target"; wt_tmp="$tmp"
  if ! out="$(git -C "$target" worktree add -q --detach "$tmp" "$ref" 2>&1)"; then
    fail "$target" "$ref" "worktree add failed${out:+ — $(tail_line "$out")}"; return 0
  fi
  for f in "${SCRIPTS[@]}"; do
    mkdir -p "$(dirname "$tmp/tools/agent-bridge/$f")" || { copy_failed=1; break; }
    cp -p "$SRC/$f" "$tmp/tools/agent-bridge/$f" || { copy_failed=1; break; }
  done
  [ "$copy_failed" -eq 0 ] || { fail "$target" "$ref" "copy into the worktree failed"; return 0; }
  chmod 755 "$tmp/tools/agent-bridge"/ask-pi "$tmp/tools/agent-bridge"/ask-claude \
    "$tmp/tools/agent-bridge"/lane "$tmp/tools/agent-bridge"/lane-guard \
    "$tmp/tools/agent-bridge"/sync "$tmp/tools/agent-bridge"/dispatch.sh 2>/dev/null || true
  if ! out="$(git -C "$tmp" add -- "${SCRIPTS[@]/#/tools/agent-bridge/}" 2>&1)"; then
    fail "$target" "$ref" "git add failed${out:+ — $(tail_line "$out")}"; return 0
  fi
  if git -C "$tmp" diff --cached --quiet; then
    # Defensive: sync judged $ref stale, so the staged copy should differ. If it
    # does not, a clean filter or EOL rule in the mirror is rewriting the blobs;
    # say so rather than report CURRENT while --check still calls it stale.
    fail "$target" "$ref" "staged copy matches $ref though sync judged it stale — check filters/EOL"; return 0
  fi
  canonical="$(git -C "$SRC" rev-parse --short HEAD 2>/dev/null || true)"
  [ -n "$canonical" ] || { fail "$target" "$ref" "cannot resolve the canonical commit (git rev-parse HEAD in $SRC failed)"; return 0; }
  # The copy source is the working tree, so an uncommitted canonical edit would
  # otherwise be pushed under a sha that does not contain it.
  [ -n "$(git -C "$SRC" status --porcelain -- "${SCRIPTS[@]}" 2>/dev/null)" ] && canonical="${canonical}-dirty"
  if ! out="$(git -C "$tmp" commit -q -m "chore(agent-bridge): sync mirror from navigate-ops $canonical" 2>&1)"; then
    fail "$target" "$ref" "commit failed${out:+ — $(tail_line "$out")}"; return 0
  fi
  if ! out="$(git -C "$tmp" push origin "HEAD:refs/heads/${branch}" 2>&1)"; then
    reason="$(printf '%s\n' "$out" | grep -m1 '^ ! ' || true)"
    [ -n "$reason" ] || reason="$(tail_line "$out")"
    fail "$target" "$ref" "push failed${reason:+ — $reason}"; return 0
  fi
  echo "PUSHED   $target  ($ref: ${*:3})"
  cleanup_worktree
  pushed=$((pushed + 1))
  return 0
}

for target in "${TARGETS[@]}"; do
  if [ ! -d "$target" ]; then
    echo "MISSING  $target — skipped"
    skipped=$((skipped + 1))
    continue
  fi
  if ! git -C "$target" remote get-url origin >/dev/null 2>&1; then
    echo "NOREMOTE $target — no origin, so no pushed backup to check"
    stale=$((stale + 1))
    continue
  fi
  git -C "$target" fetch -q origin 2>/dev/null ||
    echo "WARN     $target — fetch failed; checking the last-fetched ref"
  ref="$(git -C "$target" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)"
  dest="$target/tools/agent-bridge"
  changes=()

  for f in "${SCRIPTS[@]}"; do
    if ! git -C "$target" cat-file -e "$ref:tools/agent-bridge/$f" 2>/dev/null; then
      changes+=("+$f")
    elif ! git -C "$target" show "$ref:tools/agent-bridge/$f" | cmp -s "$SRC/$f" -; then
      changes+=("~$f")
    fi
  done

  if [ ${#changes[@]} -eq 0 ]; then
    if [ "$via_worktree" -eq 1 ]; then
      echo "CURRENT  $target  ($ref)"
    else
      echo "ok       $target  ($ref)"
    fi
    continue
  fi

  stale=$((stale + 1))
  if [ "$check_only" -eq 1 ]; then
    echo "STALE    $target  ($ref: ${changes[*]})"
    continue
  fi

  # Only write into a checkout that is on the default branch, exactly at its
  # origin tip, with a clean tools/agent-bridge/. A checkout parked on another
  # branch (or mid-edit here) belongs to someone else's work: writing into it
  # lands the files on the wrong branch. One behind or ahead of origin would
  # commit on top of a base other than the pushed copy this judged. Route
  # those through a throwaway worktree off $ref instead.
  checked_out="$(git -C "$target" branch --show-current)"
  if [ "$checked_out" != "${ref#origin/}" ] \
     || [ "$(git -C "$target" rev-parse HEAD)" != "$(git -C "$target" rev-parse "$ref")" ] \
     || [ -n "$(git -C "$target" status --porcelain -- tools/agent-bridge)" ]; then
    if [ "$via_worktree" -eq 1 ]; then
      push_parked "$target" "$ref" "${changes[@]}"
      continue
    fi
    echo "PARKED   $target  ($ref: ${changes[*]}) — checkout on '${checked_out:-detached}', not at $ref, or tools/agent-bridge/ dirty; not writing"
    echo "         copy via a throwaway worktree: git -C $target worktree add --detach <tmp> $ref"
    continue
  fi

  # A working-tree copy that differs AND is newer than canonical was edited in
  # place. Overwriting would lose that edit, so surface it instead.
  diverged=0
  for f in "${SCRIPTS[@]}"; do
    if [ -f "$dest/$f" ] && ! cmp -s "$SRC/$f" "$dest/$f" && [ "$dest/$f" -nt "$SRC/$f" ]; then
      echo "DIVERGED $dest/$f is NEWER than canonical — not overwriting $target"
      echo "         diff: diff $SRC/$f $dest/$f"
      diverged=1
    fi
  done
  [ "$diverged" -eq 1 ] && continue

  mkdir -p "$dest"
  for f in "${SCRIPTS[@]}"; do
    mkdir -p "$(dirname "$dest/$f")"
    cp "$SRC/$f" "$dest/$f"
  done
  chmod 755 "$dest"/ask-pi "$dest"/ask-claude "$dest"/lane "$dest"/lane-guard \
    "$dest"/sync "$dest"/dispatch.sh
  echo "synced   $target  ($ref: ${changes[*]})"
  copied=$((copied + 1))
done

echo
if [ "$check_only" -eq 1 ]; then
  [ "$stale" -eq 0 ] && echo "all mirrors current" || echo "$stale mirror(s) stale — run sync, then commit and push"
  exit $([ "$stale" -eq 0 ] && echo 0 || echo 1)
fi
if [ "$via_worktree" -eq 1 ]; then
  remaining=$((stale - pushed))
  echo "via-worktree: $pushed pushed, $copied copied into a working tree, $failed failed, $skipped missing."
  [ "$copied" -gt 0 ] && echo "Commit and push tools/agent-bridge/ in the $copied copied mirror(s) above — stale but not parked; re-running --via-worktree pushes the copies from a worktree and leaves them uncommitted here, so discard them before pulling."
  [ "$remaining" -gt 0 ] && echo "$remaining mirror(s) still stale after this run — see the lines above (--check lists them)."
  exit $([ "$remaining" -le 0 ] && echo 0 || echo 1)
fi
echo "synced $copied repo(s), $skipped missing. Commit and push tools/agent-bridge/ in each repo named above;"
echo "any PARKED repo goes through a throwaway worktree off its origin default branch."
