#!/usr/bin/env bash
# sync — push the canonical agent-bridge scripts to every repo that mirrors them.
#
# This directory is canonical; ~/bin symlinks here. The mirrors exist so the
# tooling survives losing this checkout. Run after changing any script, then
# commit AND push the repos this names.
#
# A mirror is current when its PUSHED copy matches canonical: each file under
# tools/agent-bridge/ at the mirror's origin default branch (fetched first).
# The backup is what is on the remote, not whatever branch a checkout happens
# to have out — a checkout parked on another session's feature branch says
# nothing about whether the mirror exists.
#
#   sync            copy into each STALE mirror's working tree, report what changed
#                   (PARKED, not written: checkout off the default branch, not
#                   at its origin tip, or tools/agent-bridge/ dirty — use a
#                   throwaway worktree)
#   sync --check    report only, change nothing (exit 1 if anything is stale)
#
# SYNC_TARGETS (space-separated paths) replaces the target list — for tests.
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Generic bridge tooling only. orchestrator-count.sh and check-task-filed.sh
# are deliberately NOT here: both hardcode navigate-ops' tasks/inbox +
# tasks/done layout and its PR conventions, so a mirror target would end up
# counting THAT repo's unrelated files and reporting nonsense. See README.md
# "What sync mirrors, and what it doesn't".
SCRIPTS=(
  ask-pi ask-claude lane lane-guard README.md sync
  dispatch.sh
  lib/frontmatter.sh lib/lane-core.sh lib/portable-date.sh lib/repo-root.sh
)

TARGETS=(
  /Users/bsingbeil/Sites/infrastructure
  /Users/bsingbeil/Sites/cool-pet-beds
  /Users/bsingbeil/Sites/energy-storage
  /Users/bsingbeil/Sites/flight-router
  /Users/bsingbeil/Sites/heat-pump
  /Users/bsingbeil/Sites/hk-imports
  /Users/bsingbeil/Sites/polymarket-system
  /Users/bsingbeil/Sites/design
)
# shellcheck disable=SC2206  # word-splitting the override is the point
[ -n "${SYNC_TARGETS:-}" ] && TARGETS=($SYNC_TARGETS)

check_only=0
[ "${1-}" = "--check" ] && check_only=1

stale=0 copied=0 skipped=0

for target in "${TARGETS[@]}"; do
  if [ ! -d "$target" ]; then
    echo "MISSING  $target — skipped"
    skipped=$((skipped + 1))
    continue
  fi
  if ! git -C "$target" remote get-url origin >/dev/null 2>&1; then
    echo "NOREMOTE $target — no origin, so no pushed backup to check"
    stale=$((stale + 1))
    continue
  fi
  git -C "$target" fetch -q origin 2>/dev/null ||
    echo "WARN     $target — fetch failed; checking the last-fetched ref"
  ref="$(git -C "$target" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)"
  dest="$target/tools/agent-bridge"
  changes=()

  for f in "${SCRIPTS[@]}"; do
    if ! git -C "$target" cat-file -e "$ref:tools/agent-bridge/$f" 2>/dev/null; then
      changes+=("+$f")
    elif ! git -C "$target" show "$ref:tools/agent-bridge/$f" | cmp -s "$SRC/$f" -; then
      changes+=("~$f")
    fi
  done

  if [ ${#changes[@]} -eq 0 ]; then
    echo "ok       $target  ($ref)"
    continue
  fi

  stale=$((stale + 1))
  if [ "$check_only" -eq 1 ]; then
    echo "STALE    $target  ($ref: ${changes[*]})"
    continue
  fi

  # Only write into a checkout that is on the default branch, exactly at its
  # origin tip, with a clean tools/agent-bridge/. A checkout parked on another
  # branch (or mid-edit here) belongs to someone else's work: writing into it
  # lands the files on the wrong branch. One behind or ahead of origin would
  # commit on top of a base other than the pushed copy this judged. Route
  # those through a throwaway worktree off $ref instead.
  checked_out="$(git -C "$target" branch --show-current)"
  if [ "$checked_out" != "${ref#origin/}" ] \
     || [ "$(git -C "$target" rev-parse HEAD)" != "$(git -C "$target" rev-parse "$ref")" ] \
     || [ -n "$(git -C "$target" status --porcelain -- tools/agent-bridge)" ]; then
    echo "PARKED   $target  ($ref: ${changes[*]}) — checkout on '${checked_out:-detached}', not at $ref, or tools/agent-bridge/ dirty; not writing"
    echo "         copy via a throwaway worktree: git -C $target worktree add --detach <tmp> $ref"
    continue
  fi

  # A working-tree copy that differs AND is newer than canonical was edited in
  # place. Overwriting would lose that edit, so surface it instead.
  diverged=0
  for f in "${SCRIPTS[@]}"; do
    if [ -f "$dest/$f" ] && ! cmp -s "$SRC/$f" "$dest/$f" && [ "$dest/$f" -nt "$SRC/$f" ]; then
      echo "DIVERGED $dest/$f is NEWER than canonical — not overwriting $target"
      echo "         diff: diff $SRC/$f $dest/$f"
      diverged=1
    fi
  done
  [ "$diverged" -eq 1 ] && continue

  mkdir -p "$dest"
  for f in "${SCRIPTS[@]}"; do
    mkdir -p "$(dirname "$dest/$f")"
    cp "$SRC/$f" "$dest/$f"
  done
  chmod 755 "$dest"/ask-pi "$dest"/ask-claude "$dest"/lane "$dest"/lane-guard \
    "$dest"/sync "$dest"/dispatch.sh
  echo "synced   $target  ($ref: ${changes[*]})"
  copied=$((copied + 1))
done

echo
if [ "$check_only" -eq 1 ]; then
  [ "$stale" -eq 0 ] && echo "all mirrors current" || echo "$stale mirror(s) stale — run sync, then commit and push"
  exit $([ "$stale" -eq 0 ] && echo 0 || echo 1)
fi
echo "synced $copied repo(s), $skipped missing. Commit and push tools/agent-bridge/ in each repo named above;"
echo "any PARKED repo goes through a throwaway worktree off its origin default branch."
